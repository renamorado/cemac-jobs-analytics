# OS and editor artifacts
desktop.ini
Thumbs.db
.DS_Store
Microsoft/Windows/PowerShell/ModuleAnalysisCache

# Agent scratch directories
.codex_tmp/
.codex_tmp_docx/
scratch/
tmp/

# Stata artifacts
*.smcl
*.stpr
*.tmp
*.bak
*.ster
*.done
*.failed

# Logs
logs/*
!logs/.gitkeep

# Generated outputs
# Track only review-ready generated artifacts: LaTeX table fragments plus
# PDF/PNG outputs used in manuscript and slide review. Keep build byproducts,
# scratch outputs, and unsupported generated formats out of Git.
output/**
!output/**/
!output/**/.gitkeep
!output/tables/**/*.tex
!output/**/*.pdf
!output/**/*.png
output/**/_codex_write_test.*

# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc

# Large or proprietary data files
Data/**/*.csv
Data/**/*.dta
Data/**/*.gz
Data/**/*.pdf
Data/**/*.rar
Data/**/*.sav
Data/**/*.xls
Data/**/*.xlsb
Data/**/*.xlsx
Data/**/*.zip
Data/**/*.7z

# Local machine overrides
config_local_paths.do
